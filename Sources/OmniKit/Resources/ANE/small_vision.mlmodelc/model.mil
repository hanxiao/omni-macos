            tensor<int32, [4]> f1_rb_shape_0 = const()[name = string("f1_rb_shape_0"), val = tensor<int32, [4]>([1, 4096, 1, 1824])];
            tensor<fp16, [1, 4096, 1, 1824]> f1_rb = reshape(shape = f1_rb_shape_0, x = f1_mm)[name = string("f1_rb")];
            tensor<fp16, [1, 4096, 1, 1824]> f1_b = add(x = f1_rb, y = b1)[name = string("f1_b")];
            string g_mode_0 = const()[name = string("g_mode_0"), val = string("EXACT")];
            tensor<fp16, [1, 4096, 1, 1824]> g_1 = gelu(mode = g_mode_0, x = f1_b)[name = string("g")];
            tensor<int32, [2]> f2_r_shape_0 = const()[name = string("f2_r_shape_0"), val = tensor<int32, [2]>([4096, 1824])];
            tensor<fp16, [4096, 1824]> f2_r = reshape(shape = f2_r_shape_0, x = g_1)[name = string("f2_r")];
            bool f2_mm_transpose_x_0 = const()[name = string("f2_mm_transpose_x_0"), val = bool(false)];
            bool f2_mm_transpose_y_0 = const()[name = string("f2_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [1024, 1824]> f2_mm = matmul(transpose_x = f2_mm_transpose_x_0, transpose_y = f2_mm_transpose_y_0, x = w2, y = f2_r)[name = string("f2_mm")];
            tensor<int32, [4]> f2_rb_shape_0 = const()[name = string("f2_rb_shape_0"), val = tensor<int32, [4]>([1, 1024, 1, 1824])];
            tensor<fp16, [1, 1024, 1, 1824]> f2_rb = reshape(shape = f2_rb_shape_0, x = f2_mm)[name = string("f2_rb")];
            tensor<fp16, [1, 1024, 1, 1824]> f2_b = add(x = f2_rb, y = b2)[name = string("f2_b")];
            tensor<fp16, [1, 1024, 1, 1824]> out = identity(x = f2_b)[name = string("out")];
        } -> (out);
    func M8192<ios18>(tensor<fp16, [1, 1024, 1, 1]> b, tensor<fp16, [1, 4096, 1, 1]> b1, tensor<fp16, [1, 1024, 1, 1]> b2, tensor<fp16, [1, 1024, 1, 1]> g, tensor<fp16, [1, 1024, 1, 8192]> h, tensor<fp16, [4096, 4096]> w1, tensor<fp16, [1024, 4096]> w2) {
            tensor<fp16, [1, 1024, 1, 8192]> mn_abs = abs(x = h)[name = string("mn_abs")];
            tensor<int32, [1]> mn_max_axes_0 = const()[name = string("mn_max_axes_0"), val = tensor<int32, [1]>([1])];
            bool mn_max_keep_dims_0 = const()[name = string("mn_max_keep_dims_0"), val = bool(true)];
            tensor<fp16, [1, 1, 1, 8192]> mn_max = reduce_max(axes = mn_max_axes_0, keep_dims = mn_max_keep_dims_0, x = mn_abs)[name = string("mn_max")];
            fp16 mn_s_y_0 = const()[name = string("mn_s_y_0"), val = fp16(0x1.a38p-14)];
            tensor<fp16, [1, 1, 1, 8192]> mn_s = add(x = mn_max, y = mn_s_y_0)[name = string("mn_s")];
            tensor<fp16, [1, 1024, 1, 8192]> mn_y = real_div(x = h, y = mn_s)[name = string("mn_y")];
            tensor<int32, [1]> mn_n_axes_0 = const()[name = string("mn_n_axes_0"), val = tensor<int32, [1]>([1])];
            fp16 mn_n_epsilon_0 = const()[name = string("mn_n_epsilon_0"), val = fp16(0x1.1p-20)];
            tensor<fp16, [1, 1024, 1, 8192]> mn_n = layer_norm(axes = mn_n_axes_0, epsilon = mn_n_epsilon_0, x = mn_y)[name = string("mn_n")];
            tensor<fp16, [1, 1024, 1, 8192]> mn_g = mul(x = mn_n, y = g)[name = string("mn_g")];
            tensor<fp16, [1, 1024, 1, 8192]> mn_out = add(x = mn_g, y = b)[name = string("mn_out")];
            tensor<int32, [3]> m3_shape_0 = const()[name = string("m3_shape_0"), val = tensor<int32, [3]>([1024, 2048, 4])];
            tensor<fp16, [1024, 2048, 4]> m3 = reshape(shape = m3_shape_0, x = mn_out)[name = string("m3")];
            tensor<int32, [3]> mt_perm_0 = const()[name = string("mt_perm_0"), val = tensor<int32, [3]>([2, 0, 1])];
            tensor<int32, [2]> f1_r_shape_0 = const()[name = string("f1_r_shape_0"), val = tensor<int32, [2]>([4096, 2048])];
            tensor<fp16, [4, 1024, 2048]> mt = transpose(perm = mt_perm_0, x = m3)[name = string("transpose_0")];
            tensor<fp16, [4096, 2048]> f1_r = reshape(shape = f1_r_shape_0, x = mt)[name = string("f1_r")];
            bool f1_mm_transpose_x_0 = const()[name = string("f1_mm_transpose_x_0"), val = bool(false)];
            bool f1_mm_transpose_y_0 = const()[name = string("f1_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [4096, 2048]> f1_mm = matmul(transpose_x = f1_mm_transpose_x_0, transpose_y = f1_mm_transpose_y_0, x = w1, y = f1_r)[name = string("f1_mm")];
            tensor<int32, [4]> f1_rb_shape_0 = const()[name = string("f1_rb_shape_0"), val = tensor<int32, [4]>([1, 4096, 1, 2048])];
            tensor<fp16, [1, 4096, 1, 2048]> f1_rb = reshape(shape = f1_rb_shape_0, x = f1_mm)[name = string("f1_rb")];
            tensor<fp16, [1, 4096, 1, 2048]> f1_b = add(x = f1_rb, y = b1)[name = string("f1_b")];
            string g_mode_0 = const()[name = string("g_mode_0"), val = string("EXACT")];
            tensor<fp16, [1, 4096, 1, 2048]> g_1 = gelu(mode = g_mode_0, x = f1_b)[name = string("g")];
            tensor<int32, [2]> f2_r_shape_0 = const()[name = string("f2_r_shape_0"), val = tensor<int32, [2]>([4096, 2048])];
            tensor<fp16, [4096, 2048]> f2_r = reshape(shape = f2_r_shape_0, x = g_1)[name = string("f2_r")];
            bool f2_mm_transpose_x_0 = const()[name = string("f2_mm_transpose_x_0"), val = bool(false)];
            bool f2_mm_transpose_y_0 = const()[name = string("f2_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [1024, 2048]> f2_mm = matmul(transpose_x = f2_mm_transpose_x_0, transpose_y = f2_mm_transpose_y_0, x = w2, y = f2_r)[name = string("f2_mm")];
            tensor<int32, [4]> f2_rb_shape_0 = const()[name = string("f2_rb_shape_0"), val = tensor<int32, [4]>([1, 1024, 1, 2048])];
            tensor<fp16, [1, 1024, 1, 2048]> f2_rb = reshape(shape = f2_rb_shape_0, x = f2_mm)[name = string("f2_rb")];
            tensor<fp16, [1, 1024, 1, 2048]> f2_b = add(x = f2_rb, y = b2)[name = string("f2_b")];
            tensor<fp16, [1, 1024, 1, 2048]> out = identity(x = f2_b)[name = string("out")];
        } -> (out);
}