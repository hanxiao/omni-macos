            string at_h11_46_qk_equation_0 = const()[name = string("at_h11_46_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_46_qk = einsum(equation = at_h11_46_qk_equation_0, values = (at_ks_11, at_h11_qb_46))[name = string("at_h11_46_qk")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_46_m = add(x = at_h11_46_qk, y = mask)[name = string("at_h11_46_m")];
            int32 at_h11_46_sm_axis_0 = const()[name = string("at_h11_46_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_46_sm = softmax(axis = at_h11_46_sm_axis_0, x = at_h11_46_m)[name = string("at_h11_46_sm")];
            string at_h11_46_av_equation_0 = const()[name = string("at_h11_46_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 64, 1, 128]> at_h11_46_av = einsum(equation = at_h11_46_av_equation_0, values = (at_vs_11, at_h11_46_sm))[name = string("at_h11_46_av")];
            string at_h11_47_qk_equation_0 = const()[name = string("at_h11_47_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_47_qk = einsum(equation = at_h11_47_qk_equation_0, values = (at_ks_11, at_h11_qb_47))[name = string("at_h11_47_qk")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_47_m = add(x = at_h11_47_qk, y = mask)[name = string("at_h11_47_m")];
            int32 at_h11_47_sm_axis_0 = const()[name = string("at_h11_47_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_47_sm = softmax(axis = at_h11_47_sm_axis_0, x = at_h11_47_m)[name = string("at_h11_47_sm")];
            string at_h11_47_av_equation_0 = const()[name = string("at_h11_47_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 64, 1, 128]> at_h11_47_av = einsum(equation = at_h11_47_av_equation_0, values = (at_vs_11, at_h11_47_sm))[name = string("at_h11_47_av")];
            string at_h11_48_qk_equation_0 = const()[name = string("at_h11_48_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_48_qk = einsum(equation = at_h11_48_qk_equation_0, values = (at_ks_11, at_h11_qb_48))[name = string("at_h11_48_qk")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_48_m = add(x = at_h11_48_qk, y = mask)[name = string("at_h11_48_m")];
            int32 at_h11_48_sm_axis_0 = const()[name = string("at_h11_48_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_48_sm = softmax(axis = at_h11_48_sm_axis_0, x = at_h11_48_m)[name = string("at_h11_48_sm")];
            string at_h11_48_av_equation_0 = const()[name = string("at_h11_48_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 64, 1, 128]> at_h11_48_av = einsum(equation = at_h11_48_av_equation_0, values = (at_vs_11, at_h11_48_sm))[name = string("at_h11_48_av")];
            string at_h11_49_qk_equation_0 = const()[name = string("at_h11_49_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_49_qk = einsum(equation = at_h11_49_qk_equation_0, values = (at_ks_11, at_h11_qb_49))[name = string("at_h11_49_qk")];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_49_m = add(x = at_h11_49_qk, y = mask)[name = string("at_h11_49_m")];
            int32 at_h11_49_sm_axis_0 = const()[name = string("at_h11_49_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6400, 1, 128]> at_h11_49_sm = softmax(axis = at_h11_49_sm_axis_0, x = at_h11_49_m)[name = string("at_h11_49_sm")];
            string at_h11_49_av_equation_0 = const()[name = string("at_h11_49_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 64, 1, 128]> at_h11_49_av = einsum(equation = at_h11_49_av_equation_0, values = (at_vs_11, at_h11_49_sm))[name = string("at_h11_49_av")];
            int32 at_h11_cat_axis_0 = const()[name = string("at_h11_cat_axis_0"), val = int32(3)];
            bool at_h11_cat_interleave_0 = const()[name = string("at_h11_cat_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 64, 1, 6400]> at_h11_cat = concat(axis = at_h11_cat_axis_0, interleave = at_h11_cat_interleave_0, values = (at_h11_0_av, at_h11_1_av, at_h11_2_av, at_h11_3_av, at_h11_4_av, at_h11_5_av, at_h11_6_av, at_h11_7_av, at_h11_8_av, at_h11_9_av, at_h11_10_av, at_h11_11_av, at_h11_12_av, at_h11_13_av, at_h11_14_av, at_h11_15_av, at_h11_16_av, at_h11_17_av, at_h11_18_av, at_h11_19_av, at_h11_20_av, at_h11_21_av, at_h11_22_av, at_h11_23_av, at_h11_24_av, at_h11_25_av, at_h11_26_av, at_h11_27_av, at_h11_28_av, at_h11_29_av, at_h11_30_av, at_h11_31_av, at_h11_32_av, at_h11_33_av, at_h11_34_av, at_h11_35_av, at_h11_36_av, at_h11_37_av, at_h11_38_av, at_h11_39_av, at_h11_40_av, at_h11_41_av, at_h11_42_av, at_h11_43_av, at_h11_44_av, at_h11_45_av, at_h11_46_av, at_h11_47_av, at_h11_48_av, at_h11_49_av))[name = string("at_h11_cat")];
            int32 at_ctx_axis_0 = const()[name = string("at_ctx_axis_0"), val = int32(1)];
            bool at_ctx_interleave_0 = const()[name = string("at_ctx_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 768, 1, 6400]> at_ctx = concat(axis = at_ctx_axis_0, interleave = at_ctx_interleave_0, values = (at_h0_cat, at_h1_cat, at_h2_cat, at_h3_cat, at_h4_cat, at_h5_cat, at_h6_cat, at_h7_cat, at_h8_cat, at_h9_cat, at_h10_cat, at_h11_cat))[name = string("at_ctx")];
            tensor<int32, [2]> o_r_shape_0 = const()[name = string("o_r_shape_0"), val = tensor<int32, [2]>([768, 6400])];
            tensor<fp16, [768, 6400]> o_r = reshape(shape = o_r_shape_0, x = at_ctx)[name = string("o_r")];
            bool o_mm_transpose_x_0 = const()[name = string("o_mm_transpose_x_0"), val = bool(false)];
            bool o_mm_transpose_y_0 = const()[name = string("o_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [768, 6400]> o_mm = matmul(transpose_x = o_mm_transpose_x_0, transpose_y = o_mm_transpose_y_0, x = wo, y = o_r)[name = string("o_mm")];
            tensor<int32, [4]> o_rb_shape_0 = const()[name = string("o_rb_shape_0"), val = tensor<int32, [4]>([1, 768, 1, 6400])];
            tensor<fp16, [1, 768, 1, 6400]> o_rb = reshape(shape = o_rb_shape_0, x = o_mm)[name = string("o_rb")];
            tensor<fp16, [1, 768, 1, 6400]> r1 = add(x = h, y = o_rb)[name = string("r1")];
            fp16 n2_s_y_0 = const()[name = string("n2_s_y_0"), val = fp16(0x1p-6)];
            tensor<fp16, [1, 768, 1, 6400]> n2_s = mul(x = r1, y = n2_s_y_0)[name = string("n2_s")];
            tensor<int32, [1]> n2_l2_axes_0 = const()[name = string("n2_l2_axes_0"), val = tensor<int32, [1]>([1])];
            bool n2_l2_keep_dims_0 = const()[name = string("n2_l2_keep_dims_0"), val = bool(true)];
            tensor<fp16, [1, 1, 1, 6400]> n2_l2 = reduce_l2_norm(axes = n2_l2_axes_0, keep_dims = n2_l2_keep_dims_0, x = n2_s)[name = string("n2_l2")];
            fp16 n2_e_y_0 = const()[name = string("n2_e_y_0"), val = fp16(0x1.a38p-14)];
            tensor<fp16, [1, 1, 1, 6400]> n2_e = add(x = n2_l2, y = n2_e_y_0)[name = string("n2_e")];
            fp16 n2_inv_x_0 = const()[name = string("n2_inv_x_0"), val = fp16(0x1.bb8p-2)];
            tensor<fp16, [1, 1, 1, 6400]> n2_inv = real_div(x = n2_inv_x_0, y = n2_e)[name = string("n2_inv")];
            tensor<fp16, [1, 768, 1, 6400]> n2_n = mul(x = r1, y = n2_inv)[name = string("n2_n")];
            tensor<fp16, [1, 768, 1, 6400]> n2_w = mul(x = n2_n, y = g2)[name = string("n2_w")];
            tensor<int32, [2]> g_r_shape_0 = const()[name = string("g_r_shape_0"), val = tensor<int32, [2]>([768, 6400])];
            tensor<fp16, [768, 6400]> g_r = reshape(shape = g_r_shape_0, x = n2_w)[name = string("g_r")];
            bool g_mm_transpose_x_0 = const()[name = string("g_mm_transpose_x_0"), val = bool(false)];
            bool g_mm_transpose_y_0 = const()[name = string("g_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [3072, 6400]> g_mm = matmul(transpose_x = g_mm_transpose_x_0, transpose_y = g_mm_transpose_y_0, x = wg, y = g_r)[name = string("g_mm")];
            tensor<int32, [4]> g_rb_shape_0 = const()[name = string("g_rb_shape_0"), val = tensor<int32, [4]>([1, 3072, 1, 6400])];
            tensor<fp16, [1, 3072, 1, 6400]> g_rb = reshape(shape = g_rb_shape_0, x = g_mm)[name = string("g_rb")];
            tensor<fp16, [1, 3072, 1, 6400]> silu = silu(x = g_rb)[name = string("silu")];
            bool u_mm_transpose_x_0 = const()[name = string("u_mm_transpose_x_0"), val = bool(false)];
            bool u_mm_transpose_y_0 = const()[name = string("u_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [3072, 6400]> u_mm = matmul(transpose_x = u_mm_transpose_x_0, transpose_y = u_mm_transpose_y_0, x = wu, y = g_r)[name = string("u_mm")];
            tensor<int32, [4]> u_rb_shape_0 = const()[name = string("u_rb_shape_0"), val = tensor<int32, [4]>([1, 3072, 1, 6400])];
            tensor<fp16, [1, 3072, 1, 6400]> u_rb = reshape(shape = u_rb_shape_0, x = u_mm)[name = string("u_rb")];
            tensor<fp16, [1, 3072, 1, 6400]> gu = mul(x = silu, y = u_rb)[name = string("gu")];
            tensor<int32, [2]> d_r_shape_0 = const()[name = string("d_r_shape_0"), val = tensor<int32, [2]>([3072, 6400])];
            tensor<fp16, [3072, 6400]> d_r = reshape(shape = d_r_shape_0, x = gu)[name = string("d_r")];
            bool d_mm_transpose_x_0 = const()[name = string("d_mm_transpose_x_0"), val = bool(false)];
            bool d_mm_transpose_y_0 = const()[name = string("d_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [768, 6400]> d_mm = matmul(transpose_x = d_mm_transpose_x_0, transpose_y = d_mm_transpose_y_0, x = wd, y = d_r)[name = string("d_mm")];
            tensor<int32, [4]> d_rb_shape_0 = const()[name = string("d_rb_shape_0"), val = tensor<int32, [4]>([1, 768, 1, 6400])];
            tensor<fp16, [1, 768, 1, 6400]> d_rb = reshape(shape = d_rb_shape_0, x = d_mm)[name = string("d_rb")];
            tensor<fp16, [1, 768, 1, 6400]> out = add(x = r1, y = d_rb)[name = string("out")];
        } -> (out);
}