    func P1<ios18>(tensor<fp16, [1, 1280, 1, 1]> b, tensor<fp16, [1, 768, 1, 1]> bias, tensor<fp16, [1, 1280, 1, 1]> g, tensor<fp16, [1, 1280, 1, 100]> h, tensor<fp16, [768, 1280]> w) {
            tensor<int32, [2]> pool_kernel_sizes_0 = const()[name = string("pool_kernel_sizes_0"), val = tensor<int32, [2]>([1, 2])];
            tensor<int32, [2]> pool_strides_0 = const()[name = string("pool_strides_0"), val = tensor<int32, [2]>([1, 2])];
            string pool_pad_type_0 = const()[name = string("pool_pad_type_0"), val = string("valid")];
            tensor<int32, [4]> pool_pad_0 = const()[name = string("pool_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            bool pool_ceil_mode_0 = const()[name = string("pool_ceil_mode_0"), val = bool(false)];
            bool pool_exclude_padding_from_average_0 = const()[name = string("pool_exclude_padding_from_average_0"), val = bool(false)];
            tensor<fp16, [1, 1280, 1, 50]> pool = avg_pool(ceil_mode = pool_ceil_mode_0, exclude_padding_from_average = pool_exclude_padding_from_average_0, kernel_sizes = pool_kernel_sizes_0, pad = pool_pad_0, pad_type = pool_pad_type_0, strides = pool_strides_0, x = h)[name = string("pool")];
            tensor<fp16, [1, 1280, 1, 50]> post_abs = abs(x = pool)[name = string("post_abs")];
            tensor<int32, [1]> post_max_axes_0 = const()[name = string("post_max_axes_0"), val = tensor<int32, [1]>([1])];
            bool post_max_keep_dims_0 = const()[name = string("post_max_keep_dims_0"), val = bool(true)];
            tensor<fp16, [1, 1, 1, 50]> post_max = reduce_max(axes = post_max_axes_0, keep_dims = post_max_keep_dims_0, x = post_abs)[name = string("post_max")];
            fp16 post_s_y_0 = const()[name = string("post_s_y_0"), val = fp16(0x1.a38p-14)];
            tensor<fp16, [1, 1, 1, 50]> post_s = add(x = post_max, y = post_s_y_0)[name = string("post_s")];
            tensor<fp16, [1, 1280, 1, 50]> post_y = real_div(x = pool, y = post_s)[name = string("post_y")];
            tensor<int32, [1]> post_n_axes_0 = const()[name = string("post_n_axes_0"), val = tensor<int32, [1]>([1])];
            fp16 post_n_epsilon_0 = const()[name = string("post_n_epsilon_0"), val = fp16(0x1.5p-17)];
            tensor<fp16, [1, 1280, 1, 50]> post_n = layer_norm(axes = post_n_axes_0, epsilon = post_n_epsilon_0, x = post_y)[name = string("post_n")];
            tensor<fp16, [1, 1280, 1, 50]> post_g = mul(x = post_n, y = g)[name = string("post_g")];
            tensor<fp16, [1, 1280, 1, 50]> post_out = add(x = post_g, y = b)[name = string("post_out")];
            tensor<int32, [2]> proj_r_shape_0 = const()[name = string("proj_r_shape_0"), val = tensor<int32, [2]>([1280, 50])];
            tensor<fp16, [1280, 50]> proj_r = reshape(shape = proj_r_shape_0, x = post_out)[name = string("proj_r")];
            bool proj_mm_transpose_x_0 = const()[name = string("proj_mm_transpose_x_0"), val = bool(false)];
            bool proj_mm_transpose_y_0 = const()[name = string("proj_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [768, 50]> proj_mm = matmul(transpose_x = proj_mm_transpose_x_0, transpose_y = proj_mm_transpose_y_0, x = w, y = proj_r)[name = string("proj_mm")];
            tensor<int32, [4]> proj_rb_shape_0 = const()[name = string("proj_rb_shape_0"), val = tensor<int32, [4]>([1, 768, 1, 50])];
            tensor<fp16, [1, 768, 1, 50]> proj_rb = reshape(shape = proj_rb_shape_0, x = proj_mm)[name = string("proj_rb")];
            tensor<fp16, [1, 768, 1, 50]> proj_b = add(x = proj_rb, y = bias)[name = string("proj_b")];
            tensor<fp16, [1, 768, 1, 50]> out = identity(x = proj_b)[name = string("out")];
        } -> (out);
    func P16<ios18>(tensor<fp16, [1, 1280, 1, 1]> b, tensor<fp16, [1, 768, 1, 1]> bias, tensor<fp16, [1, 1280, 1, 1]> g, tensor<fp16, [16, 1280, 1, 100]> h, tensor<fp16, [768, 1280]> w) {
            tensor<int32, [2]> pool_kernel_sizes_0 = const()[name = string("pool_kernel_sizes_0"), val = tensor<int32, [2]>([1, 2])];
            tensor<int32, [2]> pool_strides_0 = const()[name = string("pool_strides_0"), val = tensor<int32, [2]>([1, 2])];
