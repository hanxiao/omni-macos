            tensor<fp16, [16, 1, 1, 50]> post_s = add(x = post_max, y = post_s_y_0)[name = string("post_s")];
            tensor<fp16, [16, 1280, 1, 50]> post_y = real_div(x = pool, y = post_s)[name = string("post_y")];
            tensor<int32, [1]> post_n_axes_0 = const()[name = string("post_n_axes_0"), val = tensor<int32, [1]>([1])];
            fp16 post_n_epsilon_0 = const()[name = string("post_n_epsilon_0"), val = fp16(0x1.5p-17)];
            tensor<fp16, [16, 1280, 1, 50]> post_n = layer_norm(axes = post_n_axes_0, epsilon = post_n_epsilon_0, x = post_y)[name = string("post_n")];
            tensor<fp16, [16, 1280, 1, 50]> post_g = mul(x = post_n, y = g)[name = string("post_g")];
            tensor<fp16, [16, 1280, 1, 50]> post_out = add(x = post_g, y = b)[name = string("post_out")];
            tensor<int32, [3]> proj_r_shape_0 = const()[name = string("proj_r_shape_0"), val = tensor<int32, [3]>([16, 1280, 50])];
