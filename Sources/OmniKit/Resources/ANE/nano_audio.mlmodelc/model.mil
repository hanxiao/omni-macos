    func F1<ios18>(tensor<fp16, [1, 1280, 1, 1]> b1, tensor<fp16, [1, 1280, 1, 1]> b2, tensor<fp16, [1, 1, 1, 200]> fmask, tensor<fp16, [1, 128, 1, 200]> melx, tensor<fp16, [1, 1280, 1, 100]> pos, tensor<fp16, [1280, 128, 1, 3]> w1, tensor<fp16, [1280, 1280, 1, 3]> w2) {
            string c1_pad_type_0 = const()[name = string("c1_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> c1_pad_0 = const()[name = string("c1_pad_0"), val = tensor<int32, [4]>([0, 0, 1, 1])];
            tensor<int32, [2]> c1_strides_0 = const()[name = string("c1_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> c1_dilations_0 = const()[name = string("c1_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 c1_groups_0 = const()[name = string("c1_groups_0"), val = int32(1)];
            tensor<fp16, [1, 1280, 1, 200]> c1 = conv(dilations = c1_dilations_0, groups = c1_groups_0, pad = c1_pad_0, pad_type = c1_pad_type_0, strides = c1_strides_0, weight = w1, x = melx)[name = string("c1")];
            tensor<fp16, [1, 1280, 1, 200]> c1b = add(x = c1, y = b1)[name = string("c1b")];
            string c1g_mode_0 = const()[name = string("c1g_mode_0"), val = string("EXACT")];
            tensor<fp16, [1, 1280, 1, 200]> c1g = gelu(mode = c1g_mode_0, x = c1b)[name = string("c1g")];
            tensor<fp16, [1, 1280, 1, 200]> c1m = mul(x = c1g, y = fmask)[name = string("c1m")];
            tensor<int32, [2]> c2_strides_0 = const()[name = string("c2_strides_0"), val = tensor<int32, [2]>([1, 2])];
            string c2_pad_type_0 = const()[name = string("c2_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> c2_pad_0 = const()[name = string("c2_pad_0"), val = tensor<int32, [4]>([0, 0, 1, 1])];
            tensor<int32, [2]> c2_dilations_0 = const()[name = string("c2_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 c2_groups_0 = const()[name = string("c2_groups_0"), val = int32(1)];
            tensor<fp16, [1, 1280, 1, 100]> c2 = conv(dilations = c2_dilations_0, groups = c2_groups_0, pad = c2_pad_0, pad_type = c2_pad_type_0, strides = c2_strides_0, weight = w2, x = c1m)[name = string("c2")];
            tensor<fp16, [1, 1280, 1, 100]> c2b = add(x = c2, y = b2)[name = string("c2b")];
            string c2g_mode_0 = const()[name = string("c2g_mode_0"), val = string("EXACT")];
            tensor<fp16, [1, 1280, 1, 100]> c2g = gelu(mode = c2g_mode_0, x = c2b)[name = string("c2g")];
