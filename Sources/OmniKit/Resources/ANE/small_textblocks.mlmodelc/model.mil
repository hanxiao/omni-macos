            int32 h15_46_sm_axis_0 = const()[name = string("h15_46_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6016, 1, 128]> h15_46_sm = softmax(axis = h15_46_sm_axis_0, x = h15_46_mc)[name = string("h15_46_sm")];
            string h15_46_av_equation_0 = const()[name = string("h15_46_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 128, 1, 128]> h15_46_av = einsum(equation = h15_46_av_equation_0, values = (v7_46, h15_46_sm))[name = string("h15_46_av")];
            string h15_47_qk_equation_0 = const()[name = string("h15_47_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6144, 1, 128]> h15_47_qk = einsum(equation = h15_47_qk_equation_0, values = (k7_47, h15_qb_47))[name = string("h15_47_qk")];
            tensor<int32, [2]> h15_47_sp_split_sizes_0 = const()[name = string("h15_47_sp_split_sizes_0"), val = tensor<int32, [2]>([6016, 128])];
            int32 h15_47_sp_axis_0 = const()[name = string("h15_47_sp_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6016, 1, 128]> h15_47_sp_0, tensor<fp16, [1, 128, 1, 128]> h15_47_sp_1 = split(axis = h15_47_sp_axis_0, split_sizes = h15_47_sp_split_sizes_0, x = h15_47_qk)[name = string("h15_47_sp")];
            tensor<fp16, [1, 128, 1, 128]> h15_47_m = add(x = h15_47_sp_1, y = h0_0_m_y_0)[name = string("h15_47_m")];
            int32 h15_47_mc_axis_0 = const()[name = string("h15_47_mc_axis_0"), val = int32(1)];
            bool h15_47_mc_interleave_0 = const()[name = string("h15_47_mc_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 6144, 1, 128]> h15_47_mc = concat(axis = h15_47_mc_axis_0, interleave = h15_47_mc_interleave_0, values = (h15_47_sp_0, h15_47_m))[name = string("h15_47_mc")];
            int32 h15_47_sm_axis_0 = const()[name = string("h15_47_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6144, 1, 128]> h15_47_sm = softmax(axis = h15_47_sm_axis_0, x = h15_47_mc)[name = string("h15_47_sm")];
            string h15_47_av_equation_0 = const()[name = string("h15_47_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 128, 1, 128]> h15_47_av = einsum(equation = h15_47_av_equation_0, values = (v7_47, h15_47_sm))[name = string("h15_47_av")];
            string h15_48_qk_equation_0 = const()[name = string("h15_48_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6272, 1, 128]> h15_48_qk = einsum(equation = h15_48_qk_equation_0, values = (k7_48, h15_qb_48))[name = string("h15_48_qk")];
            tensor<int32, [2]> h15_48_sp_split_sizes_0 = const()[name = string("h15_48_sp_split_sizes_0"), val = tensor<int32, [2]>([6144, 128])];
            int32 h15_48_sp_axis_0 = const()[name = string("h15_48_sp_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6144, 1, 128]> h15_48_sp_0, tensor<fp16, [1, 128, 1, 128]> h15_48_sp_1 = split(axis = h15_48_sp_axis_0, split_sizes = h15_48_sp_split_sizes_0, x = h15_48_qk)[name = string("h15_48_sp")];
            tensor<fp16, [1, 128, 1, 128]> h15_48_m = add(x = h15_48_sp_1, y = h0_0_m_y_0)[name = string("h15_48_m")];
            int32 h15_48_mc_axis_0 = const()[name = string("h15_48_mc_axis_0"), val = int32(1)];
            bool h15_48_mc_interleave_0 = const()[name = string("h15_48_mc_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 6272, 1, 128]> h15_48_mc = concat(axis = h15_48_mc_axis_0, interleave = h15_48_mc_interleave_0, values = (h15_48_sp_0, h15_48_m))[name = string("h15_48_mc")];
            int32 h15_48_sm_axis_0 = const()[name = string("h15_48_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6272, 1, 128]> h15_48_sm = softmax(axis = h15_48_sm_axis_0, x = h15_48_mc)[name = string("h15_48_sm")];
            string h15_48_av_equation_0 = const()[name = string("h15_48_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 128, 1, 128]> h15_48_av = einsum(equation = h15_48_av_equation_0, values = (v7_48, h15_48_sm))[name = string("h15_48_av")];
            string h15_49_qk_equation_0 = const()[name = string("h15_49_qk_equation_0"), val = string("bkhc,bchq->bkhq")];
            tensor<fp16, [1, 6400, 1, 128]> h15_49_qk = einsum(equation = h15_49_qk_equation_0, values = (ksplit_7, h15_qb_49))[name = string("h15_49_qk")];
            tensor<int32, [2]> h15_49_sp_split_sizes_0 = const()[name = string("h15_49_sp_split_sizes_0"), val = tensor<int32, [2]>([6272, 128])];
            int32 h15_49_sp_axis_0 = const()[name = string("h15_49_sp_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6272, 1, 128]> h15_49_sp_0, tensor<fp16, [1, 128, 1, 128]> h15_49_sp_1 = split(axis = h15_49_sp_axis_0, split_sizes = h15_49_sp_split_sizes_0, x = h15_49_qk)[name = string("h15_49_sp")];
            tensor<fp16, [1, 128, 1, 128]> h15_49_m = add(x = h15_49_sp_1, y = h0_0_m_y_0)[name = string("h15_49_m")];
            int32 h15_49_mc_axis_0 = const()[name = string("h15_49_mc_axis_0"), val = int32(1)];
            bool h15_49_mc_interleave_0 = const()[name = string("h15_49_mc_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 6400, 1, 128]> h15_49_mc = concat(axis = h15_49_mc_axis_0, interleave = h15_49_mc_interleave_0, values = (h15_49_sp_0, h15_49_m))[name = string("h15_49_mc")];
            int32 h15_49_sm_axis_0 = const()[name = string("h15_49_sm_axis_0"), val = int32(1)];
            tensor<fp16, [1, 6400, 1, 128]> h15_49_sm = softmax(axis = h15_49_sm_axis_0, x = h15_49_mc)[name = string("h15_49_sm")];
            string h15_49_av_equation_0 = const()[name = string("h15_49_av_equation_0"), val = string("bchk,bkhq->bchq")];
            tensor<fp16, [1, 128, 1, 128]> h15_49_av = einsum(equation = h15_49_av_equation_0, values = (vsplit_7, h15_49_sm))[name = string("h15_49_av")];
            int32 h15_cat_axis_0 = const()[name = string("h15_cat_axis_0"), val = int32(3)];
            bool h15_cat_interleave_0 = const()[name = string("h15_cat_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 128, 1, 6400]> h15_cat = concat(axis = h15_cat_axis_0, interleave = h15_cat_interleave_0, values = (h15_0_av, h15_1_av, h15_2_av, h15_3_av, h15_4_av, h15_5_av, h15_6_av, h15_7_av, h15_8_av, h15_9_av, h15_10_av, h15_11_av, h15_12_av, h15_13_av, h15_14_av, h15_15_av, h15_16_av, h15_17_av, h15_18_av, h15_19_av, h15_20_av, h15_21_av, h15_22_av, h15_23_av, h15_24_av, h15_25_av, h15_26_av, h15_27_av, h15_28_av, h15_29_av, h15_30_av, h15_31_av, h15_32_av, h15_33_av, h15_34_av, h15_35_av, h15_36_av, h15_37_av, h15_38_av, h15_39_av, h15_40_av, h15_41_av, h15_42_av, h15_43_av, h15_44_av, h15_45_av, h15_46_av, h15_47_av, h15_48_av, h15_49_av))[name = string("h15_cat")];
            int32 ctx_axis_0 = const()[name = string("ctx_axis_0"), val = int32(1)];
            bool ctx_interleave_0 = const()[name = string("ctx_interleave_0"), val = bool(false)];
            tensor<fp16, [1, 2048, 1, 6400]> ctx = concat(axis = ctx_axis_0, interleave = ctx_interleave_0, values = (h0_cat, h1_cat, h2_cat, h3_cat, h4_cat, h5_cat, h6_cat, h7_cat, h8_cat, h9_cat, h10_cat, h11_cat, h12_cat, h13_cat, h14_cat, h15_cat))[name = string("ctx")];
            tensor<int32, [2]> o_r_shape_0 = const()[name = string("o_r_shape_0"), val = tensor<int32, [2]>([2048, 6400])];
            tensor<fp16, [2048, 6400]> o_r = reshape(shape = o_r_shape_0, x = ctx)[name = string("o_r")];
            bool o_mm_transpose_x_0 = const()[name = string("o_mm_transpose_x_0"), val = bool(false)];
            bool o_mm_transpose_y_0 = const()[name = string("o_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [1024, 6400]> o_mm = matmul(transpose_x = o_mm_transpose_x_0, transpose_y = o_mm_transpose_y_0, x = wo, y = o_r)[name = string("o_mm")];
            tensor<int32, [4]> o_rb_shape_0 = const()[name = string("o_rb_shape_0"), val = tensor<int32, [4]>([1, 1024, 1, 6400])];
            tensor<fp16, [1, 1024, 1, 6400]> o_rb = reshape(shape = o_rb_shape_0, x = o_mm)[name = string("o_rb")];
            tensor<fp16, [1, 1024, 1, 6400]> r1 = add(x = h, y = o_rb)[name = string("r1")];
            tensor<fp16, [1, 1024, 1, 6400]> n2_abs = abs(x = r1)[name = string("n2_abs")];
            tensor<int32, [1]> n2_max_axes_0 = const()[name = string("n2_max_axes_0"), val = tensor<int32, [1]>([1])];
            bool n2_max_keep_dims_0 = const()[name = string("n2_max_keep_dims_0"), val = bool(true)];
            tensor<fp16, [1, 1, 1, 6400]> n2_max = reduce_max(axes = n2_max_axes_0, keep_dims = n2_max_keep_dims_0, x = n2_abs)[name = string("n2_max")];
            fp16 n2_s_y_0 = const()[name = string("n2_s_y_0"), val = fp16(0x1.a38p-14)];
            tensor<fp16, [1, 1, 1, 6400]> n2_s = add(x = n2_max, y = n2_s_y_0)[name = string("n2_s")];
            tensor<fp16, [1, 1024, 1, 6400]> n2_y = real_div(x = r1, y = n2_s)[name = string("n2_y")];
            tensor<fp16, [1, 1024, 1, 6400]> n2_sq = mul(x = n2_y, y = n2_y)[name = string("n2_sq")];
            tensor<int32, [1]> n2_ms_axes_0 = const()[name = string("n2_ms_axes_0"), val = tensor<int32, [1]>([1])];
            bool n2_ms_keep_dims_0 = const()[name = string("n2_ms_keep_dims_0"), val = bool(true)];
            tensor<fp16, [1, 1, 1, 6400]> n2_ms = reduce_mean(axes = n2_ms_axes_0, keep_dims = n2_ms_keep_dims_0, x = n2_sq)[name = string("n2_ms")];
            fp16 n2_e_y_0 = const()[name = string("n2_e_y_0"), val = fp16(0x1.5p-17)];
            tensor<fp16, [1, 1, 1, 6400]> n2_e = add(x = n2_ms, y = n2_e_y_0)[name = string("n2_e")];
            fp16 n2_inv_epsilon_0 = const()[name = string("n2_inv_epsilon_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 1, 6400]> n2_inv = rsqrt(epsilon = n2_inv_epsilon_0, x = n2_e)[name = string("n2_inv")];
            tensor<fp16, [1, 1024, 1, 6400]> n2_n = mul(x = n2_y, y = n2_inv)[name = string("n2_n")];
            tensor<fp16, [1, 1024, 1, 6400]> n2_w = mul(x = n2_n, y = g2)[name = string("n2_w")];
            tensor<int32, [2]> g_r_shape_0 = const()[name = string("g_r_shape_0"), val = tensor<int32, [2]>([1024, 6400])];
            tensor<fp16, [1024, 6400]> g_r = reshape(shape = g_r_shape_0, x = n2_w)[name = string("g_r")];
            bool g_mm_transpose_x_0 = const()[name = string("g_mm_transpose_x_0"), val = bool(false)];
            bool g_mm_transpose_y_0 = const()[name = string("g_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [3072, 6400]> g_mm = matmul(transpose_x = g_mm_transpose_x_0, transpose_y = g_mm_transpose_y_0, x = wg, y = g_r)[name = string("g_mm")];
            tensor<int32, [4]> g_rb_shape_0 = const()[name = string("g_rb_shape_0"), val = tensor<int32, [4]>([1, 3072, 1, 6400])];
            tensor<fp16, [1, 3072, 1, 6400]> g_rb = reshape(shape = g_rb_shape_0, x = g_mm)[name = string("g_rb")];
            tensor<fp16, [1, 3072, 1, 6400]> silu = silu(x = g_rb)[name = string("silu")];
            bool u_mm_transpose_x_0 = const()[name = string("u_mm_transpose_x_0"), val = bool(false)];
            bool u_mm_transpose_y_0 = const()[name = string("u_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [3072, 6400]> u_mm = matmul(transpose_x = u_mm_transpose_x_0, transpose_y = u_mm_transpose_y_0, x = wu, y = g_r)[name = string("u_mm")];
            tensor<int32, [4]> u_rb_shape_0 = const()[name = string("u_rb_shape_0"), val = tensor<int32, [4]>([1, 3072, 1, 6400])];
            tensor<fp16, [1, 3072, 1, 6400]> u_rb = reshape(shape = u_rb_shape_0, x = u_mm)[name = string("u_rb")];
            tensor<fp16, [1, 3072, 1, 6400]> gu = mul(x = silu, y = u_rb)[name = string("gu")];
            tensor<int32, [2]> d_r_shape_0 = const()[name = string("d_r_shape_0"), val = tensor<int32, [2]>([3072, 6400])];
            tensor<fp16, [3072, 6400]> d_r = reshape(shape = d_r_shape_0, x = gu)[name = string("d_r")];
            bool d_mm_transpose_x_0 = const()[name = string("d_mm_transpose_x_0"), val = bool(false)];
            bool d_mm_transpose_y_0 = const()[name = string("d_mm_transpose_y_0"), val = bool(false)];
            tensor<fp16, [1024, 6400]> d_mm = matmul(transpose_x = d_mm_transpose_x_0, transpose_y = d_mm_transpose_y_0, x = wd, y = d_r)[name = string("d_mm")];
            tensor<int32, [4]> d_rb_shape_0 = const()[name = string("d_rb_shape_0"), val = tensor<int32, [4]>([1, 1024, 1, 6400])];
            tensor<fp16, [1, 1024, 1, 6400]> d_rb = reshape(shape = d_rb_shape_0, x = d_mm)[name = string("d_rb")];
            tensor<fp16, [1, 1024, 1, 6400]> out = add(x = r1, y = d_rb)[name = string("out")];
        } -> (out);
}