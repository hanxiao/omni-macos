            tensor<fp16, [1, 128, 1, 128]> h15_45_m = add(x = h15_45_sp_1, y = h0_0_m_y_0)[name = string("h15_45_m")];
            int32 h15_45_mc_axis_0 = const()[name = string("h15_45_mc_axis_0"), val = int32(1)];
